{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/PlugIns/jQuery",
      "files": [ "jquery.min.js" ]
    },
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/PlugIns/Bootstrap",
      "files": [
        "css/bootstrap.min.css",
        "js/bootstrap.bundle.min.js"
      ]
    },
    {
      "library": "sweetalert2@11.10.8",
      "destination": "wwwroot/PlugIns/SweetAlert2",
      "files": [
        "sweetalert2.min.css",
        "sweetalert2.all.min.js"
      ]
    },
    {
      "library": "datatables.net@1.13.8",
      "destination": "wwwroot/PlugIns/DataTables",
      "files": [ "jquery.dataTables.min.js" ]
    },
    {
      "library": "datatables.net-bs5@1.13.8",
      "destination": "wwwroot/PlugIns/DataTables",
      "files": [
        "dataTables.bootstrap5.min.css",
        "dataTables.bootstrap5.min.js"
      ]
    },
    {
      "library": "datatables.net-buttons@2.4.1",
      "destination": "wwwroot/PlugIns/DataTables/",
      "files": [
        "js/dataTables.buttons.min.js",
        "js/buttons.html5.min.js"
      ]
    },
    {
      "library": "datatables.net-buttons-bs5@2.4.1",
      "destination": "wwwroot/PlugIns/DataTables/",
      "files": [
        "buttons.bootstrap5.min.css"
      ]
    }
  ]
}
